{
  "expo": {
    "name": "Hospilink-frontend",
    "slug": "Hospilink-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Images/loginbg.png",
    "scheme": "hospilinkfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "...",
        "NSCameraUsageDescription": "..."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/Images/foreground.png",
        "backgroundImage": "./assets/Images/monochrome.png",
        "monochromeImage": "./assets/Images/loginbg.png",
        "permissions": ["READ_MEDIA_IMAGES", "CAMERA"]
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Hospilinkfrontend"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/Images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/Images/loginbg.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
