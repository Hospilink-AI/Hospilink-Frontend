{
  "expo": {
    "name": "Hospilink",
    "slug": "Hospilink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Images/Hospilink_icon.png",
    "scheme": "hospilinkfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HospiLink uses your location while the app is open to show you to nearby hospitals looking for staff and, during a duty you have accepted, to share your live position with that hospital.",
        "NSCameraUsageDescription": "HospiLink uses the camera so you can take a profile photo.",
        "NSPhotoLibraryUsageDescription": "HospiLink uses your photo library so you can choose a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.hospilinkfrontend"
    },
    "android": {
      "package": "com.hospilinkfrontend",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/Images/Hospilink_icon.png",
        "monochromeImage": "./assets/Images/Hospilink_icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/Images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/Images/Hospilink_icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HospiLink uses your location while the app is open to show you to nearby hospitals looking for staff and, during a duty you have accepted, to share your live position with that hospital.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HospiLink uses your photo library so you can choose a profile photo.",
          "cameraPermission": "HospiLink uses the camera so you can take a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f720691-de4e-4d1b-9819-2f68e1f5b27e"
      }
    }
  }
}
