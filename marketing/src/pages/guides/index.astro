---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Icon from "../../components/ui/Icon.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import { GUIDES, type Audience } from "../../data/guides";

const groups: { a: Audience; t: string; d: string }[] = [
  { a: "Hospitals", t: "For hospitals", d: "Posting duties and handling the urgent ones." },
  { a: "Staff", t: "For doctors, nurses and clinical staff", d: "Getting verified and finding your next role." },
  { a: "Everyone", t: "For both sides", d: "How a duty runs, how it's checked, and what happens when something goes wrong." },
];
const crumbs = [{ name: "Guides", href: "/guides/" }];
const ld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "HospiLink guides",
  hasPart: GUIDES.map((g) => ({ "@type": "Article", headline: g.title, url: `https://hospilink.in/guides/${g.slug}/` })),
};
---
<Base title="Guides" description="Step-by-step HospiLink guides: posting a duty, how offers reach staff, getting verified, start and end codes, vacancies, ratings and disputes." crumbs={crumbs} jsonLd={ld}>
  <PageHero
    title={'Every step, <span class="soft">written down.</span>'}
    lead="Short, practical guides for hospitals and staff. Each one follows the product exactly as it works today."
    crumbs={crumbs}
  />

  <div class="wrap section-tight gd-wrap">
    {groups.map((g) => (
      <section class="gd-group" aria-labelledby={`g-${g.a}`}>
        <div class="gd-head">
          <h2 id={`g-${g.a}`} class="h3">{g.t}</h2>
          <p>{g.d}</p>
        </div>
        <ul class="gd-list" role="list">
          {GUIDES.filter((x) => x.audience === g.a).map((x) => (
            <li>
              <a href={`/guides/${x.slug}/`} class="gd-item relief-white">
                <span class="icon-tile"><Icon name={x.icon} /></span>
                <span class="gd-body">
                  <span class="gd-t">{x.title}</span>
                  <span class="gd-d">{x.description}</span>
                </span>
                <span class="gd-meta"><span class="tnum">{x.minutes} min</span><Icon name="arrow-right" size={20} /></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <CtaBand title="Rather talk it through?" body="Call or write to the HospiLink team. We'll walk your hospital or you through your first duty." />
</Base>

<style>
  .gd-wrap { display: grid; gap: clamp(3rem, 6vw, 4.5rem); }
  .gd-group { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 2fr); gap: 1.5rem 4rem; align-items: start; }
  .gd-head { position: sticky; top: 110px; }
  .gd-head p { color: var(--ink-muted); margin-top: .5rem; }
  .gd-list { display: grid; gap: .8rem; }
  .gd-item { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: 1.1rem; align-items: center; padding: 1.1rem 1.3rem; border-radius: 22px; transition: transform .4s var(--ease-out), box-shadow .4s var(--ease-out); }
  .gd-item:hover { transform: translateY(-2px); box-shadow: var(--relief-high); }
  .gd-body { display: grid; gap: .25rem; }
  .gd-t { font-weight: 600; font-size: 1.08rem; letter-spacing: -0.015em; }
  .gd-d { font-size: .9rem; color: var(--ink-muted); }
  .gd-meta { display: flex; align-items: center; gap: .7rem; font-size: .82rem; font-weight: 600; color: var(--ink-muted); }
  .gd-meta :global(svg) { color: var(--ceil-deep); transition: transform .35s var(--ease-out); }
  .gd-item:hover .gd-meta :global(svg) { transform: translateX(3px); }
  @media (max-width: 860px) {
    .gd-group { grid-template-columns: minmax(0, 1fr); }
    .gd-head { position: static; }
  }
  @media (max-width: 520px) {
    .gd-item { grid-template-columns: 44px minmax(0, 1fr); padding: 1rem; }
    .gd-item :global(.icon-tile) { width: 44px; height: 44px; border-radius: 14px; }
    .gd-meta { grid-column: 2; }
  }
</style>
