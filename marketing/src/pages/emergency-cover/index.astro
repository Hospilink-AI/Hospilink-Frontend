---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Icon from "../../components/ui/Icon.astro";
import Faq from "../../components/ui/Faq.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import Phone from "../../components/ui/Phone.astro";
import { cityMap, staffDots } from "../../lib/map";
import { LINKS, COMPANY } from "../../config";
import "../../components/pages/b.css";

const crumbs = [{ name: "Emergency cover", href: "/emergency-cover/" }];
const W = 560, H = 460, CX = 280, CY = 230;
const m = cityMap(W, H, 41, 40);
const dots = staffDots(CX, CY, 34, 250, 9);
const compare = [
  { k: "Who sees it first", n: "Verified staff in that role within 30 km", e: "Verified staff in that role across the city" },
  { k: "How the reach grows", n: "5 km every hour, up to 75 km", e: "No waiting: city-wide from the first second" },
  { k: "Verification", n: "Verified staff only", e: "Verified staff only. Nothing is skipped" },
  { k: "Starting the duty", n: "Start code from your desk, inside 100 m", e: "Start code from your desk, inside 100 m" },
  { k: "Closing the duty", n: "End code your desk enters", e: "End code your desk enters" },
];
const faqs = [
  { q: "When should we use an emergency request?", a: "When a gap can't wait for the offer to widen on its own: a sudden absence on a night shift, an unexpected surge in casualty, or cover needed within the hour. For anything planned, a normal duty with a fair rate is usually enough." },
  { q: "Does an emergency skip verification?", a: "No. Emergency requests only reach verified staff in the role you asked for, and the duty still starts with a start code inside the 100 m geofence and closes with an end code your desk enters." },
  { q: "Can someone help us post one?", a: `Yes. Call ${COMPANY.phones[0].display} or ${COMPANY.phones[1].display} and we will walk you through it.` },
];
---
<Base
  title="Emergency cover: reach verified staff city-wide, at once"
  description="When a shift can't wait, raise an emergency request on HospiLink. It skips the widening and reaches verified staff in that role across the city at once, with the same start and end codes."
  crumbs={crumbs}
>
  <PageHero
    title='When it can’t wait, <span class="soft">the whole city hears it.</span>'
    lead="A normal duty widens from 30 km, hour by hour. An emergency request skips the wait and reaches verified staff in that role across the city the moment you raise it."
    crumbs={crumbs}
  >
    <Fragment slot="actions">
      <a class="btn btn-primary btn-lg" href={LINKS.hospitalSignUp}>Register to raise one <Icon name="arrow-right" class="arrow" /></a>
      <a class="btn btn-white btn-lg" href={`tel:${COMPANY.phones[0].tel}`}><Icon name="phone" /> Call us now</a>
    </Fragment>
    <div slot="visual" class="em-map" aria-hidden="true">
      <svg viewBox={`0 0 ${W} ${H}`}>
        <defs>
          <radialGradient id="emG"><stop offset=".6" stop-color="#D0322F" stop-opacity="0" /><stop offset=".97" stop-color="#F08A88" stop-opacity=".35" /><stop offset="1" stop-color="#FBE9E8" stop-opacity=".8" /></radialGradient>
        </defs>
        <clipPath id="emClip"><rect width={W} height={H} rx="28" /></clipPath>
        <g clip-path="url(#emClip)">
        <rect width={W} height={H} fill="#dde6f5" />
        <path d={m.river} fill="none" stroke="rgba(91,133,215,.22)" stroke-width="14" stroke-linecap="round" />
        <g fill="none" stroke="#fff" stroke-width="2.2">{m.minor.map((d) => <path d={d} />)}</g>
        <g fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round">{m.arterial.map((d) => <path d={d} />)}</g>
        <circle cx={CX} cy={CY} r="300" fill="url(#emG)" class="em-wave" />
        <circle cx={CX} cy={CY} r="300" fill="url(#emG)" class="em-wave w2" />
        <g>{dots.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="4.5" class="em-dot" style={`--d:${(d.d / 250).toFixed(2)}`} />)}</g>
        <g transform={`translate(${CX} ${CY})`}>
          <rect x="-19" y="-19" width="38" height="38" rx="12" fill="#D0322F" />
          <path d="M-7 0h14M0 -7v14" stroke="#fff" stroke-width="3.4" stroke-linecap="round" />
        </g>
        </g>
      </svg>
      <div class="em-chip"><Icon name="urgent" size={16} /> Emergency · city-wide</div>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="cmp-t">
    <div class="wrap">
      <div class="b-head2" data-reveal>
        <h2 id="cmp-t" class="h2">Faster reach. Exactly the same checks.</h2>
        <p class="lead">An emergency changes who hears about the duty and how quickly. It doesn't change who is allowed to take it, or how it starts and ends.</p>
      </div>
      <div class="cmp relief-high" data-reveal>
        <table>
          <caption class="sr-only">Normal duty compared with an emergency request</caption>
          <thead>
            <tr><th scope="col"><span class="sr-only">Aspect</span></th><th scope="col">Normal duty</th><th scope="col" class="emh"><Icon name="urgent" size={16} /> Emergency request</th></tr>
          </thead>
          <tbody>
            {compare.map((r) => (
              <tr><th scope="row">{r.k}</th><td>{r.n}</td><td class="emc">{r.e}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section field-dark b-dark-band on-dark" aria-labelledby="two-t">
    <div class="wrap b-split">
      <div class="b-copy" data-reveal>
        <h2 id="two-t" class="h2">What happens <span class="soft">on each side.</span></h2>
        <div class="sides">
          <div>
            <h3><Icon name="building-hospital" /> Your hospital</h3>
            <ol class="mini" role="list">
              <li>Raise the duty as an <b>emergency request</b>.</li>
              <li>Watch for the first acceptance, then follow them on the map.</li>
              <li>Read out the start code at the desk when they arrive.</li>
              <li>Enter their end code to close it, then rate.</li>
            </ol>
          </div>
          <div>
            <h3><Icon name="stethoscope" /> Staff nearby</h3>
            <ol class="mini" role="list">
              <li>An emergency offer arrives, marked in red, with rate and distance.</li>
              <li>The first to accept gets it, and heads straight there.</li>
              <li>Ask the desk for the start code within 100 m of the hospital.</li>
              <li>At the end, read the SMS end code to the desk.</li>
            </ol>
          </div>
        </div>
      </div>
      <div class="em-phone" data-reveal style="--d:.1s">
        <Phone>
          <div class="ep">
            <div class="ep-alert">
              <span class="tag tag-red"><Icon name="urgent" /> Emergency</span>
              <p class="ep-role">RMO · Casualty</p>
              <p class="ep-m"><Icon name="building-hospital" size={14} /> Aranya Hospital · <span class="tnum">4.6 km</span></p>
              <p class="ep-m"><Icon name="clock" size={14} /> Starts now · 8 hours</p>
              <div class="ep-f"><span class="tnum"><b>₹1,800</b> <small>for 8 hours</small></span></div>
              <div class="ep-btn">Accept emergency duty</div>
            </div>
            <p class="ep-note">Same checks at the door: start code inside 100 m.</p>
          </div>
        </Phone>
        <p class="sample on-dark ep-s">Illustration · sample data</p>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="faq-t">
    <div class="wrap b-faq">
      <div class="head" data-reveal>
        <h2 id="faq-t" class="h2">Emergency requests, answered</h2>
        <p class="lead">See the full flow on <a href="/how-it-works/">how it works</a>.</p>
      </div>
      <div data-reveal style="--d:.08s"><Faq items={faqs} /></div>
    </div>
  </section>

  <CtaBand title="Be ready before the next 2 AM phone call." body="Register your hospital now, so an emergency request is a few taps away when you need it." />
</Base>

<style>
  .em-map { position: relative; padding: 10px; border-radius: 36px; background: rgba(255, 255, 255, .6); -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur); box-shadow: var(--glass-edge), var(--float); }
  .em-map svg { width: 100%; height: auto; overflow: visible; }
  .em-wave { transform-box: fill-box; transform-origin: center; animation: emw 2.8s var(--ease-out) infinite; }
  .em-wave.w2 { animation-delay: 1.4s; }
  @keyframes emw { from { transform: scale(.05); opacity: 1; } to { transform: scale(1); opacity: 0; } }
  .em-dot { fill: #9fb1d4; animation: emd 2.8s infinite; animation-delay: calc(var(--d) * 2.2s); }
  @keyframes emd { 0%, 100% { fill: #9fb1d4; opacity: .6; } 10% { fill: #d0322f; opacity: 1; } }
  .em-chip { position: absolute; left: 50%; bottom: 14%; translate: -50% 0; white-space: nowrap; display: inline-flex; align-items: center; gap: .4rem; padding: .55rem .95rem; border-radius: 99px; background: var(--red); color: #fff; font-weight: 600; font-size: .84rem; box-shadow: 0 12px 26px -10px rgba(208, 50, 47, .8); }

  .cmp { padding: .6rem; overflow-x: auto; }
  .cmp table { width: 100%; border-collapse: collapse; min-width: 560px; }
  .cmp th, .cmp td { text-align: left; padding: 1rem 1.2rem; vertical-align: top; }
  .cmp thead th { font-size: .86rem; font-weight: 600; color: var(--ink-muted); }
  .cmp thead th.emh { color: var(--red); display: flex; align-items: center; gap: .35rem; }
  .cmp tbody th { font-weight: 600; width: 24%; }
  .cmp tbody tr + tr > * { border-top: 1px solid var(--line); }
  .cmp td { color: var(--ink-soft); font-weight: 600; }
  .cmp td.emc { background: rgba(251, 233, 232, .55); color: var(--ink); }
  .cmp tbody tr:first-child td.emc { border-radius: 14px 14px 0 0; }
  .cmp tbody tr:last-child td.emc { border-radius: 0 0 14px 14px; }

  .sides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 2rem; }
  .sides h3 { display: flex; align-items: center; gap: .5rem; font-size: 1.1rem; color: var(--navy); }
  .sides h3 :global(svg) { color: var(--ceil-deep); }
  .mini { list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: .8rem; counter-reset: s; }
  .mini li { position: relative; padding-left: 2.2rem; color: var(--on-dark-soft); font-size: .95rem; counter-increment: s; }
  .mini li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 24px; height: 24px; border-radius: 8px; display: grid; place-items: center; background: rgba(255, 255, 255, .1); font-size: .76rem; font-weight: 600; color: var(--navy); }
  .mini b { color: var(--navy); }

  .em-phone { display: grid; justify-items: center; gap: 1rem; }
  .ep { padding: 50px 12px 14px; display: grid; gap: .8rem; align-content: start; height: 100%; background: linear-gradient(180deg, var(--red-soft), var(--ward) 45%); }
  .ep-alert { padding: 1rem; border-radius: 20px; background: #fff; box-shadow: 0 0 0 2px var(--red), 0 16px 30px -14px rgba(208, 50, 47, .6); animation: epp 2s ease-in-out infinite; }
  @keyframes epp { 50% { box-shadow: 0 0 0 5px rgba(208, 50, 47, .35), 0 16px 30px -14px rgba(208, 50, 47, .6); } }
  .ep-role { font-weight: 600; font-size: 1.1rem; margin-top: .6rem; }
  .ep-m { display: flex; align-items: center; gap: .35rem; font-size: .76rem; font-weight: 550; color: var(--ink-muted); margin-top: .15rem; }
  .ep-m :global(svg) { color: var(--red); }
  .ep-f { margin-top: .7rem; }
  .ep-f b { font-size: 1.15rem; }
  .ep-f small { font-size: .72rem; color: var(--ink-muted); font-weight: 550; }
  .ep-btn { margin-top: .8rem; height: 44px; border-radius: 99px; background: var(--red); color: #fff; display: grid; place-items: center; font-weight: 600; font-size: .84rem; }
  .ep-note { font-size: .74rem; font-weight: 600; color: var(--ink-muted); text-align: center; padding: 0 .5rem; }
  @media (max-width: 700px) { .sides { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .em-wave, .em-dot, .ep-alert { animation: none; } .em-wave { opacity: .5; } }
</style>
