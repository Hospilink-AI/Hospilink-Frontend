---
import Icon from "./Icon.astro";
import { LINKS } from "../../config";
interface Props { title?: string; body?: string; primary?: "hospital" | "staff" }
const {
  title = "Your next shift, covered by someone verified.",
  body = "Hospitals register on the web and post their first duty in minutes. Doctors, nurses and clinical staff get the Android app and start seeing duties near them.",
  primary = "hospital",
} = Astro.props;
---
<section class="cta-band" aria-labelledby="cta-title">
  <div class="wrap-wide">
    <div class="cta-card">
      <svg class="cta-arc" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true"><path d="M60 300 C 300 -40, 700 -40, 940 300" pathLength="1" /></svg>
      <span class="cta-dot a" aria-hidden="true"></span><span class="cta-dot b" aria-hidden="true"></span>
      <h2 id="cta-title" class="h2">{title}</h2>
      <p class="lead">{body}</p>
      <div class="cta-actions">
        {primary === "staff" ? (
          <>
            <a class="btn btn-primary btn-lg" href={LINKS.playStore}><Icon name="brand-google-play" /> Get the staff app</a>
            <a class="btn btn-relief btn-lg" href={LINKS.hospitalSignUp}>I'm a hospital <Icon name="arrow-right" class="arrow" /></a>
          </>
        ) : (
          <>
            <a class="btn btn-primary btn-lg" href={LINKS.hospitalSignUp}>Post a duty <Icon name="arrow-right" class="arrow" /></a>
            <a class="btn btn-dark btn-lg" href={LINKS.playStore}><Icon name="brand-google-play" /> Get the staff app</a>
          </>
        )}
      </div>
      <p class="cta-call">Prefer to talk? Call <a href="tel:+919529011896" class="tnum">+91 95290 11896</a> or <a href="tel:+919960241860" class="tnum">+91 99602 41860</a></p>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: calc(var(--section) * .7); position: relative; z-index: 1; }
  .cta-card {
    position: relative; overflow: hidden; isolation: isolate; text-align: center; display: grid; justify-items: center;
    padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.4rem, 5vw, 4rem);
    border-radius: 44px;
    background:
      radial-gradient(60% 80% at 15% 100%, rgba(201, 216, 244, .95), transparent 70%),
      radial-gradient(50% 70% at 90% 0%, rgba(169, 192, 236, .8), transparent 70%),
      radial-gradient(40% 60% at 70% 100%, rgba(207, 242, 255, .9), transparent 70%),
      #eef3fc;
    box-shadow: var(--relief-high), inset 0 1px 0 #fff;
  }
  .cta-arc { position: absolute; inset: 52% 0 0 0; width: 100%; height: 48%; z-index: -1; }
  .cta-arc path { fill: none; stroke: rgba(68, 110, 192, .28); stroke-width: 2; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .cta-dot { position: absolute; bottom: -7px; width: 16px; height: 16px; border-radius: 50%; z-index: -1; }
  .cta-dot.a { left: 6%; background: var(--navy); }
  .cta-dot.b { right: 6%; background: var(--ceil); }
  .cta-card h2 { max-width: 18ch; }
  .cta-card .lead { margin-top: 1.2rem; }
  .cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; margin-top: 2.2rem; }
  .cta-call { margin-top: 1.6rem; font-size: .9rem; font-weight: 550; color: var(--ink-muted); }
  .cta-call a { color: var(--navy); font-weight: 600; white-space: nowrap; }
  .cta-call a:hover { color: var(--ceil-700); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 560px) { .cta-card { border-radius: 30px; } .cta-actions .btn { width: 100%; } }
</style>
