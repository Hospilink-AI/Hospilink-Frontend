---
import Icon from "../ui/Icon.astro";
import { cityMap, staffDots } from "../../lib/map";
import { LINKS } from "../../config";

const W = 1100, H = 820;
const HX = 420, HY = 430;           // hospital
const R30 = 330;                    // 30 km reach on this illustration
const map = cityMap(W, H, 7, 48);
const dots = staffDots(HX, HY, 26, R30 - 14, 23);
const CX = 300, CY = 330;           // the staff member who accepts
const route = `M${CX} ${CY} L${CX + 8} ${CY + 34} Q ${CX + 12} ${CY + 50} ${CX + 30} ${CY + 52} L ${HX - 44} ${HY - 22} Q ${HX - 20} ${HY - 18} ${HX - 12} ${HY - 6} L ${HX} ${HY}`;
// The brand's link arc, drawn between the two people it connects.
const arc = `M${CX} ${CY} A 80 80 0 0 1 ${HX} ${HY - 2}`;

const checks = [
  { t: "Verified staff only", s: "Aadhaar, licence and medical registration checked" },
  { t: "Offered within 30 km", s: "Reach widens 5 km every hour, up to 75 km" },
  { t: "First to accept gets it", s: "Accepted by Priya S., ICU nurse" },
  { t: "Start code + 100 m geofence", s: "Read out by your duty desk, checked on arrival" },
  { t: "End code, entered by the hospital", s: "Then both sides rate each other" },
];
const statuses = [
  { k: "live", label: "Offer live", icon: "broadcast" },
  { k: "accepted", label: "Accepted", icon: "user-check" },
  { k: "route", label: "En route · arriving 7:52 PM", icon: "navigation" },
  { k: "door", label: "At the desk · start code", icon: "map-pin-check" },
  { k: "done", label: "Completed · confirmed", icon: "circle-check" },
];
---
<section class="hero field-dark" aria-labelledby="hero-title" style={`--hx:${HX}px;--hy:${HY}px`}>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="display">
        Live staffing, <br /><span class="soft">trusted</span> healthcare.
      </h1>
      <p class="lead on-dark hero-lead">
        A hospital posts a duty. Verified doctors and nurses nearby see it at once, the first to accept is on the way, and every step from the door to sign-off is checked.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={LINKS.hospitalSignUp}>Post a duty <Icon name="arrow-right" class="arrow" /></a>
        <a class="btn btn-white btn-lg" href={LINKS.playStore}><Icon name="brand-google-play" /> Get the staff app</a>
      </div>
      <a href="/vacancies/" class="hero-pill">
        <span class="live-dot" aria-hidden="true"></span>
        Permanent vacancies are now open
        <Icon name="arrow-right" size={16} />
      </a>
      <ul class="hero-facts" role="list">
        <li><Icon name="shield-check" size={18} /> Verified once, trusted every shift</li>
        <li><Icon name="map-pin" size={18} /> Starting in Pune</li>
      </ul>
    </div>

    <div class="stage" data-stage data-phase="0" role="img"
      aria-label="Sample duty: an ICU staff nurse duty is offered to verified staff within 30 kilometres, accepted, tracked to the hospital, started with a code from the duty desk inside a 100 metre geofence, and closed with an end code the hospital enters.">
      <svg class="map" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        <defs>
          <radialGradient id="sweepG">
            <stop offset="0.72" stop-color="#5B85D7" stop-opacity="0" />
            <stop offset="0.97" stop-color="#8FB0EE" stop-opacity="0.32" />
            <stop offset="1" stop-color="#C9D8F4" stop-opacity="0.7" />
          </radialGradient>
          <radialGradient id="reachG">
            <stop offset="0" stop-color="#5B85D7" stop-opacity="0.12" />
            <stop offset="1" stop-color="#5B85D7" stop-opacity="0.04" />
          </radialGradient>
          <filter id="soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
        </defs>
        <rect class="ground" x="-200" y="-200" width={W + 400} height={H + 400} />
        <g class="parks">{map.parks.map((p) => <ellipse cx={p.cx} cy={p.cy} rx={p.rx} ry={p.ry} transform={`rotate(${p.rot} ${p.cx} ${p.cy})`} />)}</g>
        <path class="river" d={map.river} />
        <g class="streets">{map.minor.map((d) => <path d={d} />)}</g>
        <g class="arterials">{map.arterial.map((d) => <path d={d} />)}</g>

        <circle class="reach75" cx={HX} cy={HY} r={R30 * 2.5} />
        <circle class="reach" cx={HX} cy={HY} r={R30} />
        <g class="sweep"><circle cx={HX} cy={HY} r={R30} fill="url(#sweepG)" /></g>
        <g class="reach-label" transform={`translate(${HX + R30 * 0.7} ${HY + R30 * 0.7})`}>
          <rect x="-8" y="-17" width="74" height="28" rx="14" />
          <text x="29" y="2" text-anchor="middle">30 km</text>
        </g>

        <g class="dots">
          {dots.map((d) => (
            <g class="dot" style={`--d:${d.delay.toFixed(3)}`} transform={`translate(${d.x.toFixed(1)} ${d.y.toFixed(1)})`}>
              <circle class="halo" r="13" />
              <circle class="core" r="5" />
            </g>
          ))}
        </g>

        <path class="route" d={route} pathLength="1" />
        <path class="link-arc" d={arc} pathLength="1" />

        <g class="chosen" data-chosen transform={`translate(${CX} ${CY})`}>
          <circle class="c-halo" r="22" />
          <circle class="c-core" r="9" />
          <circle class="c-in" r="3.5" />
        </g>

        <g class="hospital" transform={`translate(${HX} ${HY})`}>
          <circle class="geofence" r="44" />
          <circle class="h-ring" r="26" />
          <rect x="-18" y="-18" width="36" height="36" rx="11" class="h-tile" />
          <path d="M-6 0h12M0 -6v12" class="h-cross" />
        </g>
      </svg>

      <div class="chip chip-geo glass" aria-hidden="true"><Icon name="radar-2" size={16} /> 100 m geofence</div>
      <div class="chip chip-eta glass" aria-hidden="true"><Icon name="navigation" size={16} /> <span class="tnum">9 min</span> away</div>

      <article class="offer glass" aria-hidden="true">
        <header class="o-head">
          <div class="o-status">
            {statuses.map((s, i) => (
              <span class="st" data-st={i}><Icon name={s.icon} size={15} /> {s.label}</span>
            ))}
          </div>
          <span class="sample">Sample duty</span>
        </header>
        <div class="o-tags"><span class="tag tag-navy"><Icon name="moon" /> Overnight</span><span class="tag tag-saline">ICU</span></div>
        <h2 class="o-title">ICU Staff Nurse</h2>
        <ul class="o-meta" role="list">
          <li><Icon name="building-hospital" size={16} /> Aranya Hospital · Baner</li>
          <li><Icon name="clock" size={16} /> Tonight · 8 PM to 8 AM · 12 h</li>
        </ul>
        <ol class="o-chain" role="list">
          {checks.map((c, i) => (
            <li class="ck" data-ck={i}>
              <span class="ck-mark"><Icon name="check" size={13} stroke={3} /></span>
              <span class="ck-t">{c.t}<small>{c.s}</small></span>
            </li>
          ))}
        </ol>
        <footer class="o-foot">
          <div class="o-rate"><b class="tnum">₹2,160</b><span>for the duty</span><small>12 hours · shown before accepting</small></div>
          <div class="o-otp tnum" aria-hidden="true">{"482913".split("").map((n) => <span>{n}</span>)}</div>
          <div class="o-cta">
            <span class="o-ring"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15" /></svg><b class="tnum">4:52</b></span>
            <span class="o-cta-t">Accept duty</span>
          </div>
        </footer>
      </article>
    </div>
  </div>
</section>

<style>
  .hero { min-height: max(100svh, 760px); padding-top: clamp(7rem, 5rem + 5vw, 9rem); padding-bottom: 7rem; overflow: hidden; display: flex; align-items: center; }
  .hero-glow { position: absolute; inset: auto -10% -40% 30%; height: 80%; background: radial-gradient(closest-side, rgba(169, 192, 236, .55), transparent); filter: blur(40px); z-index: -1; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; gap: 2rem; position: relative; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-pill {
    display: inline-flex; align-items: center; gap: .6rem; height: 40px; padding: 0 1rem 0 .9rem; border-radius: var(--r-pill);
    background: rgba(255, 255, 255, .6); box-shadow: var(--glass-edge), 0 6px 16px -10px rgba(14, 30, 58, .25); font-size: .86rem; font-weight: 600; color: var(--navy);
    -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur); transition: background-color .25s;
  }
  .hero-pill:hover { background: #fff; }
  .hero-pill :global(svg) { transition: transform .3s var(--ease-out); }
  .hero-pill:hover :global(svg) { transform: translateX(3px); }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #3fcf8e; animation: livepulse 2.2s infinite; }
  @keyframes livepulse { 0% { box-shadow: 0 0 0 0 rgba(63, 207, 142, .55); } 70% { box-shadow: 0 0 0 9px rgba(63, 207, 142, 0); } 100% { box-shadow: 0 0 0 0 rgba(63, 207, 142, 0); } }
  .hero h1 { margin-top: 0; }
  .hero-pill { margin-top: 2rem; }
  .hero h1 .soft { color: var(--ceil-deep); }
  .hero-lead { margin-top: 1.6rem; max-width: 34rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.3rem; }
  .hero-facts { display: flex; flex-wrap: wrap; gap: .5rem 1.6rem; margin-top: 1.4rem; color: var(--ink-muted); font-size: .9rem; font-weight: 550; }
  .hero-facts li { display: inline-flex; align-items: center; gap: .45rem; }
  .hero-facts :global(svg) { color: var(--ceil-deep); }

  /* Stage */
  .stage { position: relative; aspect-ratio: 1100 / 820; width: 128%; margin-left: -14%; margin-right: -14%; margin-block: -4rem; }
  .map { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible;
    -webkit-mask-image: radial-gradient(62% 64% at 44% 52%, #000 55%, transparent 100%);
    mask-image: radial-gradient(62% 64% at 44% 52%, #000 55%, transparent 100%); }
  .ground { fill: #dde6f5; }
  .parks ellipse { fill: rgba(19, 128, 74, .07); }
  .river { fill: none; stroke: rgba(91, 133, 215, .22); stroke-width: 16; stroke-linecap: round; }
  .streets path { fill: none; stroke: rgba(255, 255, 255, .95); stroke-width: 2.2; }
  .arterials path { fill: none; stroke: #fff; stroke-width: 6; stroke-linecap: round; filter: drop-shadow(0 1px 1px rgba(14, 30, 58, .08)); }
  .reach { fill: url(#reachG); stroke: rgba(68, 110, 192, .55); stroke-width: 1.5; stroke-dasharray: 2 7; stroke-linecap: round; }
  .reach75 { fill: none; stroke: rgba(68, 110, 192, .22); stroke-width: 1.2; stroke-dasharray: 2 9; stroke-linecap: round; }
  .reach-label rect { fill: #fff; stroke: rgba(68, 110, 192, .25); }
  .reach-label text { fill: var(--navy); font: 600 13px var(--font); }
  .sweep { transform-origin: var(--hx) var(--hy); transform-box: view-box; animation: sweep 3.6s cubic-bezier(.2, .6, .3, 1) infinite; }
  @keyframes sweep { 0% { transform: scale(.04); opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { transform: scale(1); opacity: 0; } }

  .dot .core { fill: #5b85d7; opacity: .55; }
  .dot .halo { fill: #8fb0ee; opacity: 0; }
  .dot { animation: none; }
  .dot .core { animation: lit 3.6s infinite; animation-delay: calc(var(--d) * 3.06s); }
  .dot .halo { animation: ping 3.6s infinite; animation-delay: calc(var(--d) * 3.06s); transform-box: fill-box; transform-origin: center; }
  @keyframes lit { 0%, 100% { opacity: .5; fill: #8fb0ee; } 6% { opacity: 1; fill: #2a4480; } 40% { opacity: .85; fill: #446ec0; } }
  @keyframes ping { 0% { opacity: .55; transform: scale(.4); } 30% { opacity: 0; transform: scale(1.4); } 100% { opacity: 0; } }

  .route { fill: none; stroke: var(--ceil-deep); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; transition: stroke-dashoffset 1.6s var(--ease-in-out), opacity .4s; }
  .link-arc { fill: none; stroke: var(--ceil); stroke-width: 3.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s var(--ease-out), opacity .5s; }
  .chosen .c-halo { fill: rgba(91, 133, 215, .35); opacity: 0; transform-box: fill-box; transform-origin: center; }
  .chosen .c-core { fill: var(--ceil); stroke: #fff; stroke-width: 3; opacity: 0; transition: opacity .4s; }
  .chosen .c-in { fill: #fff; opacity: 0; transition: opacity .4s; }

  .hospital .h-tile { fill: #fff; filter: drop-shadow(0 6px 14px rgba(14, 30, 58, .22)); }
  .hospital .h-cross { stroke: var(--red); stroke-width: 3.4; stroke-linecap: round; }
  .hospital .h-ring { fill: none; stroke: rgba(68, 110, 192, .45); stroke-width: 1.5; animation: hring 2.4s var(--ease-out) infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes hring { from { transform: scale(.7); opacity: .9; } to { transform: scale(1.9); opacity: 0; } }
  .hospital .geofence { fill: rgba(63, 207, 142, .14); stroke: #3fcf8e; stroke-width: 2; stroke-dasharray: 4 5; opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(.6); transition: opacity .5s, transform .8s var(--ease-out); }

  /* Phases: 0 live · 1 accepted · 2 en route · 3 at door · 4 completed */
  .stage:not([data-phase="0"]) .sweep { animation-play-state: paused; opacity: 0; transition: opacity .4s; }
  .stage:not([data-phase="0"]) .dot { opacity: .35; transition: opacity .6s; }
  .stage:not([data-phase="0"]) .dot .core, .stage:not([data-phase="0"]) .dot .halo { animation: none; }
  .stage:not([data-phase="0"]) .chosen .c-core, .stage:not([data-phase="0"]) .chosen .c-in { opacity: 1; }
  .stage:not([data-phase="0"]) .chosen .c-halo { animation: hring 1.8s var(--ease-out) infinite; }
  .stage[data-phase="1"] .link-arc { stroke-dashoffset: 0; }
  .stage[data-phase="2"] .link-arc, .stage[data-phase="3"] .link-arc, .stage[data-phase="4"] .link-arc { stroke-dashoffset: 0; opacity: .25; }
  .stage[data-phase="2"] .route { opacity: .9; stroke-dashoffset: 0; }
  .stage[data-phase="3"] .route, .stage[data-phase="4"] .route { opacity: .25; stroke-dashoffset: 0; }
  .stage[data-phase="3"] .geofence, .stage[data-phase="4"] .geofence { opacity: 1; transform: scale(1); }
  .stage[data-phase="4"] .geofence { stroke: var(--green); fill: rgba(19, 128, 74, .1); }

  /* Chips */
  .chip { position: absolute; display: inline-flex; align-items: center; gap: .4rem; height: 36px; padding: 0 .85rem; border-radius: var(--r-pill); font-size: .8rem; font-weight: 600; color: var(--navy); opacity: 0; transform: translateY(6px); transition: opacity .5s, transform .6s var(--ease-out); pointer-events: none; }
  .chip :global(svg) { color: var(--ceil-deep); }
  .chip-geo { left: 26%; top: 64%; }
  .chip-eta { left: 14%; top: 28%; }
  .stage[data-phase="2"] .chip-eta { opacity: 1; transform: none; }
  .stage[data-phase="3"] .chip-geo { opacity: 1; transform: none; }

  /* Offer card */
  .offer { position: absolute; right: 14%; bottom: 4%; width: min(390px, 42%); padding: 1.15rem 1.15rem 1rem; color: var(--navy); border-radius: 26px; background: rgba(255, 255, 255, .8); }
  .o-head { display: flex; justify-content: space-between; align-items: center; gap: .6rem; min-height: 28px; }
  .o-status { position: relative; height: 28px; flex: 1; }
  .st { position: absolute; inset: 0 auto 0 0; display: inline-flex; align-items: center; gap: .35rem; height: 28px; padding: 0 .7rem; border-radius: var(--r-pill); font-size: .76rem; font-weight: 600; white-space: nowrap; background: var(--saline); color: var(--ceil-700); opacity: 0; transform: translateY(4px); transition: opacity .35s, transform .45s var(--ease-out); }
  .st[data-st="0"] { background: var(--red); color: #fff; }
  .st[data-st="4"] { background: var(--green-soft); color: var(--green-ink); }
  .st[data-st="3"] { background: var(--amber-soft); color: var(--amber-ink); }
  .stage[data-phase="0"] .st[data-st="0"], .stage[data-phase="1"] .st[data-st="1"], .stage[data-phase="2"] .st[data-st="2"], .stage[data-phase="3"] .st[data-st="3"], .stage[data-phase="4"] .st[data-st="4"] { opacity: 1; transform: none; }
  .o-tags { display: flex; gap: .4rem; margin-top: .85rem; }
  .o-title { font-size: 1.35rem; letter-spacing: -0.025em; margin-top: .55rem; }
  .o-meta { display: grid; gap: .25rem; margin-top: .45rem; font-size: .84rem; color: var(--ink-soft); font-weight: 600; }
  .o-meta li { display: flex; align-items: center; gap: .45rem; }
  .o-meta :global(svg) { color: var(--ceil-deep); flex: none; }
  .o-chain { list-style: none; padding: .7rem .75rem; margin-top: .85rem; display: grid; gap: .5rem; border-radius: 18px; background: rgba(240, 242, 247, .75); box-shadow: var(--relief-pressed); counter-reset: ck; }
  .ck { display: grid; grid-template-columns: 22px 1fr; gap: .55rem; align-items: start; font-size: .83rem; font-weight: 600; line-height: 1.25; color: var(--ink-muted); transition: color .4s; }
  .ck small { display: block; font-size: .73rem; font-weight: 500; color: var(--ink-muted); margin-top: 1px; }
  .ck-mark { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1.5px var(--line-strong); color: transparent; transition: background-color .4s, box-shadow .4s, color .4s, transform .5s var(--ease-out); }
  .ck.on { color: var(--navy); }
  .ck.on small { color: var(--ink-muted); }
  .ck.on .ck-mark { background: var(--green); box-shadow: none; color: #fff; transform: scale(1.06); }
  .ck.now .ck-mark { box-shadow: inset 0 0 0 2px var(--ceil-deep); animation: nowp 1.2s infinite; }
  @keyframes nowp { 50% { box-shadow: inset 0 0 0 2px var(--ceil-deep), 0 0 0 5px rgba(68, 110, 192, .18); } }

  .o-foot { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin-top: .9rem; min-height: 50px; position: relative; }
  .o-rate { display: flex; align-items: baseline; gap: .1rem; flex-wrap: wrap; }
  .o-rate b { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.03em; }
  .o-rate span { font-size: .82rem; font-weight: 550; color: var(--ink-muted); margin-left: .3rem; }
  .o-rate small { width: 100%; font-size: .74rem; font-weight: 550; color: var(--ink-muted); }
  .o-cta { position: absolute; right: 0; top: 50%; translate: 0 -50%; display: inline-flex; align-items: center; gap: .55rem; white-space: nowrap; flex: none; height: 48px; padding: 0 1.1rem 0 .4rem; border-radius: var(--r-pill); background: var(--ceil-deep); color: #fff; font-weight: 600; font-size: .9rem; box-shadow: 0 10px 22px -10px rgba(68, 110, 192, .9); transition: background-color .4s, opacity .4s, transform .4s var(--ease-out); }
  .o-ring { position: relative; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--navy); }
  .o-ring svg { position: absolute; inset: 2px; transform: rotate(-90deg); }
  .o-ring circle { fill: none; stroke: #fff; stroke-width: 2.6; stroke-dasharray: 94.2; stroke-dashoffset: 18; stroke-linecap: round; }
  .o-ring b { font-size: .64rem; font-weight: 600; }
  .stage:not([data-phase="0"]) .o-cta { opacity: 0; transform: scale(.94); pointer-events: none; }
  .stage[data-phase="0"] .o-rate { max-width: calc(100% - 170px); }
  .o-rate small { white-space: nowrap; }
  .o-otp { position: absolute; right: 0; top: 50%; translate: 0 -50%; display: flex; gap: 4px; opacity: 0; transition: opacity .4s; }
  .o-otp span { width: 26px; height: 34px; display: grid; place-items: center; border-radius: 9px; background: #fff; box-shadow: inset 0 0 0 1.5px var(--green); font-weight: 600; font-size: .95rem; color: var(--navy); }
  .stage[data-phase="3"] .o-otp { opacity: 1; }
  .stage[data-phase="4"] .o-otp { opacity: 0; }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .hero { padding-bottom: 4rem; min-height: auto; }
    .stage { width: 112%; margin: -1rem -6% 0; }
    .offer { right: 10%; }
    .offer { width: min(380px, 52%); }
  }
  @media (max-width: 680px) {
    .stage { width: 170%; margin: -1rem -35% 0; aspect-ratio: auto; }
    .map { position: relative; inset: auto; height: auto; aspect-ratio: 1100 / 820; margin-left: 6%; }
    .offer { position: relative; right: auto; bottom: auto; width: auto; margin: -34% calc(35% / 1.7 + 0px) 0; margin-inline: 20.6%; }
    .chip { display: none; }
    .hero h1 br { display: none; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage) {
    const checks = stage.querySelectorAll<HTMLElement>(".ck");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Phase → number of checks complete, and which one is in progress.
    const plan = [
      { done: 2, now: 2, ms: 4200 },  // offer live: verified + within 30 km
      { done: 3, now: 3, ms: 2200 },  // accepted
      { done: 3, now: 3, ms: 3200 },  // en route
      { done: 4, now: 4, ms: 3000 },  // at the door, start OTP
      { done: 5, now: -1, ms: 3600 }, // completed, confirmed
    ];
    const set = (p: number) => {
      stage.dataset.phase = String(p);
      checks.forEach((c, i) => {
        c.classList.toggle("on", i < plan[p].done);
        c.classList.toggle("now", i === plan[p].now);
      });
      document.dispatchEvent(new CustomEvent("hl:phase", { detail: p }));
    };
    if (reduce) {
      set(4);
    } else {
      let p = 0, timer = 0, visible = true;
      const tick = () => {
        set(p);
        timer = window.setTimeout(() => { p = (p + 1) % plan.length; if (visible && !document.hidden) tick(); }, plan[p].ms);
      };
      const io = new IntersectionObserver(([e]) => {
        const was = visible; visible = e.isIntersecting;
        if (visible && !was) { clearTimeout(timer); tick(); }
      });
      io.observe(stage);
      document.addEventListener("visibilitychange", () => { if (!document.hidden && visible) { clearTimeout(timer); tick(); } });
      tick();

      // Move the accepting nurse along the route while en route.
      const route = stage.querySelector<SVGPathElement>(".route");
      const chosen = stage.querySelector<SVGGElement>("[data-chosen]");
      if (route && chosen) {
        const len = route.getTotalLength();
        const start = route.getPointAtLength(0);
        let raf = 0;
        document.addEventListener("hl:phase", (e) => {
          const ph = (e as CustomEvent<number>).detail;
          cancelAnimationFrame(raf);
          if (ph === 2) {
            const t0 = performance.now(), dur = 2900;
            const step = (t: number) => {
              const k = Math.min(1, (t - t0) / dur);
              const ease = k < .5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
              const pt = route.getPointAtLength(len * ease);
              chosen.setAttribute("transform", `translate(${pt.x} ${pt.y})`);
              if (k < 1) raf = requestAnimationFrame(step);
            };
            raf = requestAnimationFrame(step);
          } else if (ph === 0 || ph === 1) {
            chosen.setAttribute("transform", `translate(${start.x} ${start.y})`);
          } else {
            const end = route.getPointAtLength(len);
            chosen.setAttribute("transform", `translate(${end.x + 26} ${end.y - 20})`);
          }
        });
      }
    }
  }
</script>
