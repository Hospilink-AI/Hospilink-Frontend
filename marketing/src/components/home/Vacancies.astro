---
import Icon from "../ui/Icon.astro";
import { LINKS } from "../../config";
import { ROLES } from "../../data/roles";

const track = [
  { k: "Application sent", d: "Mon 6 Oct", icon: "send" },
  { k: "Being reviewed", d: "Tue 7 Oct", icon: "eye" },
  { k: "Shortlisted", d: "Wed 8 Oct", icon: "list-check" },
  { k: "Pick an interview time", d: "Thu 9 Oct", icon: "calendar-time" },
  { k: "Interview scheduled", d: "Fri 10 Oct · 11 AM", icon: "video" },
  { k: "Offer received", d: "Tue 14 Oct", icon: "mail-opened" },
  { k: "Hired", d: "Joining 1 Nov", icon: "confetti" },
];
const quick = ["rmo", "icu_nurse", "staff_nurse", "intensivist", "ot_technician", "lab_technician", "emergency_doctor", "dialysis_technician"]
  .map((v) => ROLES.find((r) => r.value === v)!)
  .filter(Boolean);
---
<section id="vacancies" class="vac" aria-labelledby="vac-title">
  <div class="vac-bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="vac-top">
      <div class="vac-copy" data-reveal>
        <h2 id="vac-title" class="h1">Permanent vacancies.<br />Same verified profile.</h2>
        <p class="lead">
          Hospitals on HospiLink also hire for permanent roles. Apply with the profile you already verified and a résumé, pick an interview time that works, and follow every step until the offer.
        </p>
        <div class="vac-actions">
          <a class="btn btn-dark btn-lg" href="/vacancies/">Browse all vacancies <Icon name="arrow-right" class="arrow" /></a>
          <a class="btn btn-relief btn-lg" href={LINKS.hospitalSignUp}>Post a vacancy</a>
        </div>
      </div>

      <div class="tracker glass" data-reveal style="--d:.1s" aria-label="How an application moves">
        <div class="tr-head">
          <div>
            <p class="tr-t">Your application</p>
            <p class="tr-s">Staff Nurse (Ward) · Full time</p>
          </div>
          <span class="sample">Sample</span>
        </div>
        <ol class="tr-list" role="list" data-tracker>
          {track.map((t, i) => (
            <li style={`--i:${i}`}>
              <span class="tr-node"><Icon name={t.icon} size={16} /></span>
              <span class="tr-k">{t.k}</span>
              <span class="tr-d tnum">{t.d}</span>
            </li>
          ))}
        </ol>
        <p class="tr-foot"><Icon name="brand-google" size={16} /> Interviews by Google Meet link, sent by the hospital</p>
      </div>
    </div>

    <div class="board glass" data-reveal>
      <div class="board-head">
        <h3 class="board-t">Latest vacancies</h3>
        <ul class="quick" role="list" aria-label="Browse by role">
          {quick.map((r) => <li><a href={`/vacancies/roles/${r.slug}/`}>{r.short}</a></li>)}
          <li><a href="/vacancies/roles/" class="more">All roles <Icon name="arrow-right" size={15} /></a></li>
        </ul>
      </div>
      <div class="board-list" data-vac-list aria-live="polite" aria-busy="true">
        {[0, 1, 2].map(() => (
          <div class="vcard skel" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        ))}
      </div>
      <div class="board-state" data-vac-state hidden></div>
    </div>
  </div>
</section>

<style>
  .vac { position: relative; padding-block: var(--section); overflow: hidden; isolation: isolate; }
  .vac-bg { position: absolute; inset: 0; z-index: -1;
    -webkit-mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
    background:
      radial-gradient(50% 50% at 85% 20%, rgba(91, 133, 215, .35), transparent 70%),
      radial-gradient(40% 50% at 10% 85%, rgba(201, 216, 244, .9), transparent 70%),
      radial-gradient(35% 35% at 50% 60%, rgba(63, 207, 142, .12), transparent 70%),
      linear-gradient(180deg, var(--ward), var(--saline) 40%, var(--ward)); }
  .vac-top { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .vac-flag { margin-bottom: 1.4rem; }
  .vac-flag .live-dot { width: 7px; height: 7px; border-radius: 50%; background: #3fcf8e; animation: livepulse 2.2s infinite; }
  @keyframes livepulse { 0% { box-shadow: 0 0 0 0 rgba(63, 207, 142, .55); } 70% { box-shadow: 0 0 0 8px rgba(63, 207, 142, 0); } 100% { box-shadow: 0 0 0 0 rgba(63, 207, 142, 0); } }
  .vac-copy .lead { margin-top: 1.4rem; }
  .vac-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.2rem; }

  .tracker { padding: 1.4rem; border-radius: 28px; }
  .tr-head { display: flex; justify-content: space-between; align-items: start; }
  .tr-t { font-weight: 600; font-size: 1.05rem; }
  .tr-s { font-size: .83rem; color: var(--ink-muted); font-weight: 550; }
  .tr-list { position: relative; display: grid; gap: .3rem; margin-top: 1.1rem; }
  .tr-list::before { content: ""; position: absolute; left: 17px; top: 18px; bottom: 18px; width: 2px; background: var(--line); }
  .tr-list li { position: relative; display: flex; align-items: center; gap: .85rem; padding: .35rem 0; font-weight: 600; font-size: .92rem; color: var(--ink-faint); transition: color .4s; transition-delay: calc(var(--i) * .3s); }
  .tr-d { margin-left: auto; font-size: .8rem; font-weight: 500; color: var(--ink-muted); white-space: nowrap; }
  .tr-node { position: relative; z-index: 1; width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; background: #fff; box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink-faint); transition: background-color .4s, color .4s, box-shadow .4s; transition-delay: calc(var(--i) * .3s); }
  .tracker.in .tr-list li { color: var(--navy); }
  .tracker.in .tr-node { background: var(--ceil-deep); color: #fff; box-shadow: none; }
  .tracker.in .tr-list li:last-child .tr-node { background: var(--green); }
  .tr-foot { display: flex; align-items: center; gap: .45rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(195, 205, 224, .6); font-size: .8rem; font-weight: 550; color: var(--ink-muted); }

  .board { margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(1.1rem, 2vw, 1.8rem); border-radius: 34px; background: rgba(255, 255, 255, .55); }
  .board-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; padding: .3rem .4rem 1.3rem; }
  .board-t { font-size: 1.35rem; }
  .quick { display: flex; flex-wrap: wrap; gap: .45rem; }
  .quick a { display: inline-flex; align-items: center; gap: .3rem; height: 36px; padding: 0 .9rem; border-radius: 99px; background: #fff; font-size: .84rem; font-weight: 600; color: var(--ink-soft); box-shadow: 0 1px 2px rgba(14, 30, 58, .06), inset 0 0 0 1px var(--line); transition: color .2s, box-shadow .2s, background-color .2s; }
  .quick a:hover { color: var(--ceil-700); box-shadow: inset 0 0 0 1.5px var(--ceil); }
  .quick a.more { background: var(--navy); color: #fff; box-shadow: none; }
  .board-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .board-state:not([hidden]) { display: grid; justify-items: center; text-align: center; gap: .8rem; padding: 3rem 1rem; }

  @media (max-width: 1000px) {
    .vac-top { grid-template-columns: minmax(0, 1fr); }
    .board-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .board-list { grid-template-columns: minmax(0, 1fr); }
    .board { border-radius: 26px; }
  }
</style>

<script>
  import { listVacancies, vacancyCard } from "../../lib/vacancies";
  import { emptyState, errorState } from "../../lib/vacancyStates";

  const tracker = document.querySelector<HTMLElement>(".tracker");
  if (tracker) {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { tracker.classList.add("in"); io.disconnect(); } }, { threshold: 0.5 });
    io.observe(tracker);
  }

  const list = document.querySelector<HTMLElement>("[data-vac-list]");
  const state = document.querySelector<HTMLElement>("[data-vac-state]");
  async function load() {
    if (!list || !state) return;
    list.setAttribute("aria-busy", "true");
    try {
      const page = await listVacancies({ limit: 6 });
      if (!page.vacancies.length) {
        list.innerHTML = "";
        state.innerHTML = emptyState();
        state.hidden = false;
      } else {
        list.innerHTML = page.vacancies.map(vacancyCard).join("");
        state.hidden = true;
      }
    } catch {
      list.innerHTML = "";
      state.innerHTML = errorState();
      state.hidden = false;
      state.querySelector("[data-retry]")?.addEventListener("click", () => { state.hidden = true; load(); });
    } finally {
      list.setAttribute("aria-busy", "false");
    }
  }
  // Load when the board comes near, not on first paint.
  if (list) {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); load(); } }, { rootMargin: "400px" });
    io.observe(list);
  }
</script>
