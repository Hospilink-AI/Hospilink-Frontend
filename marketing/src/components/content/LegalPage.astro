---
import Base from "../../layouts/Base.astro";
import PageHero from "../ui/PageHero.astro";
import Icon from "../ui/Icon.astro";
import LegalBlocks from "./LegalBlocks.astro";
import { COMPANY } from "../../config";
import type { LegalDocument } from "../../data/legal/types";

interface Props { doc: LegalDocument; path: string; description: string; other: { label: string; href: string } }
const { doc, path, description, other } = Astro.props;
const slug = (t: string) => t.toLowerCase().replace(/^\d+\.\s*/, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---
<Base title={doc.title} description={description} crumbs={[{ name: doc.title, href: path }]}>
  <PageHero compact title={doc.title} crumbs={[{ name: doc.title, href: path }]}>
    <p class="lg-meta">
      <span><Icon name="calendar" size={16} /> Last updated {doc.updated}</span>
      <span><Icon name="building" size={16} /> {COMPANY.legalName}</span>
    </p>
  </PageHero>

  <div class="wrap lg-grid section-tight">
    <aside class="lg-toc" aria-label="On this page">
      <nav class="relief">
        <p class="toc-t">On this page</p>
        <ol role="list">
          {doc.sections.map((s) => <li><a href={`#${slug(s.title)}`}>{s.title}</a></li>)}
        </ol>
        <div class="toc-foot">
          <a href={other.href} class="link-arrow">{other.label} <Icon name="arrow-right" /></a>
          <button type="button" class="toc-print" data-print><Icon name="printer" size={18} /> Print</button>
        </div>
      </nav>
    </aside>

    <article class="prose lg-body">
      {doc.intro.map((p) => <p class="lg-intro">{p}</p>)}
      {doc.sections.map((s) => (
        <section id={slug(s.title)} class="lg-sec">
          <h2>{s.title}</h2>
          <LegalBlocks blocks={s.blocks} />
        </section>
      ))}
      <p class="lg-end">Questions about this document? Write to <a href={`mailto:${COMPANY.emails.info}`}>{COMPANY.emails.info}</a>. Complaints go to our Grievance Officer at <a href={`mailto:${COMPANY.emails.support}`}>{COMPANY.emails.support}</a>.</p>
    </article>
  </div>
</Base>

<style>
  .lg-meta { display: flex; flex-wrap: wrap; gap: .6rem 1.6rem; margin-top: 1.4rem; color: var(--on-dark-soft); font-weight: 550; font-size: .92rem; }
  .lg-meta span { display: inline-flex; align-items: center; gap: .45rem; }
  .lg-meta :global(svg) { color: var(--ceil-deep); }
  .lg-grid { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .lg-toc { position: sticky; top: 104px; }
  .lg-toc nav { padding: 1.3rem 1.2rem; border-radius: 22px; }
  .toc-t { font-weight: 600; font-size: .92rem; margin-bottom: .7rem; }
  .lg-toc ol { display: grid; gap: .15rem; }
  .lg-toc ol a { display: block; padding: .38rem .6rem; border-radius: 10px; font-size: .87rem; font-weight: 550; color: var(--ink-soft); transition: background-color .2s, color .2s; }
  .lg-toc ol a:hover, .lg-toc ol a.on { background: #fff; color: var(--ceil-700); }
  .toc-foot { display: grid; gap: .8rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .toc-foot .link-arrow { font-size: .9rem; }
  .toc-print { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; font-size: .88rem; color: var(--ink-muted); }
  .toc-print:hover { color: var(--navy); }
  .lg-body { max-width: 72ch; }
  .lg-intro:first-child { font-size: 1.12rem; color: var(--ink); }
  .lg-sec { scroll-margin-top: 110px; }
  .lg-sec:first-of-type h2 { margin-top: 1.8em; }
  .lg-body :global(.lg-sub) { margin-top: 1.1em; }
  .lg-body :global(.lg-sub h3) { font-size: 1.05rem; color: var(--ink); margin-top: 1.2em; }
  .lg-body :global(.lg-sub h4) { font-size: .98rem; color: var(--ink); margin-top: 1em; }
  .lg-body :global(.lg-sub > * + *) { margin-top: .55em; }
  .lg-body :global(a) { color: var(--ceil-700); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--ceil-300); }
  .lg-end { margin-top: 3em !important; padding: 1.2rem 1.4rem; border-radius: 18px; background: var(--saline); color: var(--ink-soft); font-size: .95rem; }
  @media (max-width: 960px) {
    .lg-grid { grid-template-columns: minmax(0, 1fr); }
    .lg-toc { position: static; }
  }
  @media print {
    :global(header.hdr), :global(footer.ftr), .lg-toc, :global(.skip) { display: none !important; }
    :global(.page-hero) { background: none !important; color: #000 !important; padding: 0 0 1rem !important; }
    :global(.page-hero .crumbs), :global(.ph-arc) { display: none !important; }
    .lg-meta { color: #333; }
    .lg-grid { display: block; }
    .lg-body { max-width: none; color: #000; }
  }
</style>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
  const links = document.querySelectorAll<HTMLAnchorElement>(".lg-toc ol a");
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((l) => l.classList.toggle("on", l.getAttribute("href") === `#${e.target.id}`));
    });
  }, { rootMargin: "-20% 0px -70% 0px" });
  document.querySelectorAll(".lg-sec").forEach((s) => io.observe(s));
</script>
